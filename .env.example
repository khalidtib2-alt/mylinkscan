# Creem license validation. Leave empty to disable Creem verification.
CREEM_API_KEY=

# Optional Gumroad fallback for Pro license verification.
GUMROAD_PRODUCT_ID=

# Optional comma-separated master license keys.
PRO_MASTER_KEYS=

# Pro checkout and direct crypto payments.
NEXT_PUBLIC_PRO_CHECKOUT_URL=
NEXT_PUBLIC_CRYPTO_POLYGON_ADDRESS=
NEXT_PUBLIC_CRYPTO_TRON_ADDRESS=
CRYPTO_LICENSE_SECRET=
POLYGON_RPC_URL=
TRON_PRO_API_KEY=
CREEM_WEBHOOK_SECRET=
ADMIN_DASHBOARD_SECRET=
